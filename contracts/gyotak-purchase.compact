pragma language_version >= 0.22;

import CompactStandardLibrary;

// Purchase commitment (gyotak-purchase)
//
// Records "someone bought lot X" without revealing who the buyer is, and — when
// the buyer chooses to speak publicly — records which public account is making
// the claim.
//
// Two ledgers, written separately:
//
//   purchases  every purchase. The buyer is hidden inside a commitment.
//   bindings   the subset the buyer has attached a public handle to. Written
//              only for buyers who have registered a handle; a buyer who stays
//              silent has purchases and no binding.
//
// Reading both together gives "@handle bought lot X at time T". Reading only
// purchases gives "someone bought lot X at time T".
//
// What the chain attests to is bounded: that these records existed at block N,
// have not been altered since, and were not back-dated. It does not attest that
// the purchase physically occurred.

struct PurchaseRecord {
  // Purchase id (plaintext; same value as the Map key).
  purchaseId: Bytes<32>,
  // persistentCommit<Bytes<32>>(buyerId32, nonce)
  //   = SHA-256(nonce ‖ buyerId32)   — identical to purchase_commitment in the
  //   operator's database, so a buyer can reproduce it with one hash, without
  //   any Midnight tooling.
  purchaseCommitment: Bytes<32>,
  // Catch lot id = SHA-256("gyotak:lot:" ‖ catch_report_id). Stored in plaintext.
  lotId: Bytes<32>,
  // Commitment time (unix seconds). Bound to chain time by the blockTime asserts.
  committedAt: Uint<64>,
  // Record version. v1 = 1.
  schema: Uint<8>,
}

// Links one purchase to the public account that claims it.
//
// The handle is stored in plaintext, deliberately. A reader who sees the post
// already knows the handle; publishing it here lets them compare directly,
// without computing anything. The trade-off is that the set of accounts that
// have claimed a GYOTAK purchase becomes publicly enumerable — which is the
// point, since these are accounts that chose to speak.
struct XBinding {
  // The purchase this binding refers to. Same value as the Map key, and the key
  // of the corresponding entry in `purchases`.
  purchaseId: Bytes<32>,
  // Public account handle, without the leading "@", ASCII, right-padded with
  // zero bytes. X handles are at most 15 characters.
  // Self-reported by the buyer; see recordXBinding.
  handle: Bytes<32>,
  // Binding time (unix seconds). Bound to chain time by the blockTime asserts.
  // A binding whose block time precedes the post it supports cannot have been
  // fabricated in response to that post.
  boundAt: Uint<64>,
  // Record version. v1 = 1.
  schema: Uint<8>,
}

export ledger purchases: Map<Bytes<32>, PurchaseRecord>;
export ledger bindings: Map<Bytes<32>, XBinding>;
export ledger owner: Bytes<32>;

// Buyer identifier (32 bytes). The operator passes through the value it fixed in
// its database.
witness getBuyerId(purchaseId: Bytes<32>): Bytes<32>;
// Opening nonce (32 bytes). Issued by the operator and held in a table separate
// from the commitments. Never logged.
witness getPurchaseNonce(purchaseId: Bytes<32>): Bytes<32>;
witness localSecretKey(): Bytes<32>;

export pure circuit publicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "gyotak:purchase:pk:"), sk]);
}

constructor(initialOwner: Bytes<32>) {
  owner = disclose(initialOwner);
}

export circuit recordPurchase(
  purchaseId: Bytes<32>,
  lotId: Bytes<32>,
  schema: Uint<8>,
  timestamp: Uint<64>
): [] {
  const sk = localSecretKey();
  assert(disclose(publicKey(sk) == owner), "unauthorized");

  // Bind the commitment time to the chain's own clock, within ±600 seconds
  // (the same window used by temp-log and catch v3).
  const t = disclose(timestamp);
  const lower = (t - 600) as Uint<64>;
  const upper = (t + 600) as Uint<64>;
  assert(blockTimeGte(lower), "timestamp too far in past");
  assert(blockTimeLte(upper), "timestamp too far in future");

  // Insert only. Once recorded, a purchase can be neither updated nor deleted.
  assert(!purchases.member(disclose(purchaseId)), "purchase already exists");

  // Buyer id and nonce arrive as witnesses; the commitment is formed in-circuit.
  const buyerId = getBuyerId(purchaseId);
  const nonce = getPurchaseNonce(purchaseId);
  const purchaseCommitment = persistentCommit<Bytes<32>>(buyerId, nonce);

  const record = PurchaseRecord {
    purchaseId: purchaseId,
    purchaseCommitment: purchaseCommitment,
    lotId: lotId,
    committedAt: timestamp,
    schema: schema,
  };
  purchases.insert(disclose(purchaseId), disclose(record));
}

// Attaches a public account handle to a purchase already on this ledger.
//
// Written once per purchase, immediately after recordPurchase, for buyers who
// have registered a handle with the operator.
//
// The handle is self-reported. The operator authenticates the buyer — the
// registration arrives over the same authenticated session the purchase did, so
// the operator knows which customer is speaking — but it does not verify that
// the handle given belongs to that customer. A buyer could register someone
// else's handle and the operator would not detect it.
//
// So this record means: at block N, the operator recorded that the buyer of this
// purchase claimed this handle. It does not mean the handle is theirs. A reader
// who wants more should look for the purchase id on the account itself; an
// account that publishes it is doing something the operator cannot do for it.
export circuit recordXBinding(
  purchaseId: Bytes<32>,
  handle: Bytes<32>,
  schema: Uint<8>,
  timestamp: Uint<64>
): [] {
  const sk = localSecretKey();
  assert(disclose(publicKey(sk) == owner), "unauthorized");

  const t = disclose(timestamp);
  const lower = (t - 600) as Uint<64>;
  const upper = (t + 600) as Uint<64>;
  assert(blockTimeGte(lower), "timestamp too far in past");
  assert(blockTimeLte(upper), "timestamp too far in future");

  // A binding without its purchase would be unverifiable, so require the
  // purchase first.
  assert(purchases.member(disclose(purchaseId)), "purchase not found");

  // Insert only, as with purchases. A handle cannot be reassigned after the
  // fact, which is what makes the binding's block time meaningful.
  assert(!bindings.member(disclose(purchaseId)), "binding already exists");

  const record = XBinding {
    purchaseId: purchaseId,
    handle: handle,
    boundAt: timestamp,
    schema: schema,
  };
  bindings.insert(disclose(purchaseId), disclose(record));
}

export circuit rotateOwner(newOwner: Bytes<32>): [] {
  const sk = localSecretKey();
  assert(disclose(publicKey(sk) == owner), "unauthorized");
  owner = disclose(newOwner);
}

export circuit verifyPurchase(purchaseId: Bytes<32>): PurchaseRecord {
  assert(purchases.member(disclose(purchaseId)), "purchase not found");
  return purchases.lookup(disclose(purchaseId));
}

export circuit verifyXBinding(purchaseId: Bytes<32>): XBinding {
  assert(bindings.member(disclose(purchaseId)), "binding not found");
  return bindings.lookup(disclose(purchaseId));
}
